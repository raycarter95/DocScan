// Trage hier die iOS-OAuth-Client-ID aus der Google Cloud Console ein (siehe README).
// Beispiel: 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID = DEINE_CLIENT_ID.apps.googleusercontent.com
// Umgekehrte Client-ID (steht ebenfalls in der Console), z.B. com.googleusercontent.apps.1234567890-abcdefg
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.DEINE_CLIENT_ID
